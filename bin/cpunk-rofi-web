#!/usr/bin/env python3
"""Rofi script mode that opens typed queries in Google."""
import os
import subprocess
import sys
from urllib.parse import quote_plus


if os.environ.get('ROFI_RETV') == '2':
    query = ' '.join(sys.argv[1:]).strip()
    if query:
        subprocess.Popen(
            ['xdg-open', 'https://www.google.com/search?q=' + quote_plus(query)],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True,
        )
else:
    print('\0message\x1fType a Google search and press Enter.')
    print('Search Google\0nonselectable\x1ftrue')
