configuration {
    show-icons: true;
    icon-theme: "Yaru";
    modi: "drun";
    matching: "fuzzy";
    case-sensitive: false;
    sidebar-mode: true;
    drun-use-desktop-cache: false;
    click-to-exit: true;
    font: "Cantarell 12";
    kb-move-word-back: "Alt+b";
    kb-move-word-forward: "Alt+f";
    kb-mode-next: "Control+Right,Control+Tab";
    kb-mode-previous: "Control+Left,Control+ISO_Left_Tab";
}
* {
    background-color: #0b0d12f5;
    text-color: #eef2f7ff;
    border-color: #3a4252ff;
    selected-color: #72152fe8;
    selected-border: #d92f50e6;
    muted-color: #929badff;
}

window {
    width: 660px;
    height: 480px;
    location: center;
    anchor: center;
    transparency: "real";
    background-color: #0b0d12f5;
    border: 1px;
    border-color: #3a4252e6;
    border-radius: 16px;
}

mainbox {
    children: [ inputbar, mode-switcher, message, listview, textbox-help ];
    spacing: 8px;
    padding: 13px;
    background-color: transparent;
    expand: true;
}

inputbar {
    children: [ textbox-search, entry ];
    padding: 11px 14px;
    spacing: 10px;
    background-color: #181c25f0;
    border: 1px;
    border-color: #3a4252e6;
    border-radius: 10px;
    expand: false;
}

textbox-search {
    str: "⌕";
    background-color: transparent;
    text-color: #f43f5eff;
    font: "Cantarell Bold 20";
    vertical-align: 0.5;
    expand: false;
}

entry {
    background-color: transparent;
    text-color: #ffffffff;
    placeholder: "Search apps, files, and commands";
    placeholder-color: @muted-color;
    font: "Cantarell 12";
    horizontal-align: 0.0;
    expand: true;
}

mode-switcher {
    spacing: 4px;
    padding: 0px 2px;
    background-color: transparent;
    expand: false;
}

button {
    padding: 5px 8px;
    background-color: transparent;
    text-color: @muted-color;
    border: 1px;
    border-color: transparent;
    border-radius: 6px;
    font: "Cantarell 10";
}

button selected {
    background-color: #31151de8;
    text-color: #ffffffff;
    border-color: #d92f50b8;
}

message {
    padding: 0px;
    background-color: transparent;
    expand: false;
}

message textbox {
    padding: 8px 10px;
    background-color: #11151cff;
    text-color: @muted-color;
    border-radius: 7px;
}

listview {
    columns: 1;
    lines: 6;
    fixed-height: true;
    fixed-columns: true;
    dynamic: false;
    expand: true;
    spacing: 2px;
    scrollbar: true;
    layout: vertical;
    background-color: transparent;
}

element {
    orientation: horizontal;
    padding: 7px 11px;
    spacing: 11px;
    background-color: transparent;
    text-color: #eef2f7ff;
    border: 1px;
    border-color: transparent;
    border-radius: 7px;
}

element alternate.normal {
    background-color: transparent;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @selected-color;
    text-color: #ffffffff;
    border-color: @selected-border;
    border-radius: 7px;
}

element-icon {
    size: 30px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    horizontal-align: 0.0;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
    font: "Cantarell 12";
}

scrollbar {
    width: 3px;
    handle-color: #566074ff;
    background-color: #151922cc;
    border-radius: 3px;
}

textbox {
    background-color: transparent;
}

textbox-help {
    str: "↑  ↓  Navigate     Enter  Open     Esc  Close     Ctrl+←/→  Tabs";
    padding: 8px 3px 1px;
    background-color: transparent;
    text-color: @muted-color;
    border: 1px 0px 0px 0px;
    border-color: #303746cc;
    font: "Cantarell 9";
    expand: false;
}
