configuration {
    show-icons: true;
    icon-theme: "Yaru";
    modi: "drun";
    matching: "fuzzy";
    case-sensitive: false;
    sidebar-mode: true;
    drun-use-desktop-cache: false;
    click-to-exit: true;
    font: "JetBrains Mono 12";
    kb-move-word-back: "Alt+b";
    kb-move-word-forward: "Alt+f";
    kb-mode-next: "Control+Right,Control+Tab";
    kb-mode-previous: "Control+Left,Control+ISO_Left_Tab";
}
* {
    background-color: #0b0d12ff;
    text-color: #eef2f7ff;
    border-color: #303746ff;
    accent-color: #f43f5eff;
    accent-soft: #9f1239ff;
    muted-color: #929badff;
}

window {
    width: 680px;
    height: 560px;
    location: center;
    anchor: center;
    transparency: "real";
    background-color: #0b0d12ff;
    border: 1px;
    border-color: #3a4252ff;
    border-radius: 18px;
}

mainbox {
    children: [ inputbar, mode-switcher, message, listview, textbox-help ];
    spacing: 10px;
    padding: 16px;
    background-color: #0b0d12ff;
    expand: true;
}

inputbar {
    children: [ prompt, entry ];
    padding: 16px 18px;
    spacing: 14px;
    background-color: #181c25ff;
    border: 1px;
    border-color: #303746ff;
    border-radius: 12px;
    expand: false;
}

prompt {
    background-color: transparent;
    text-color: @accent-color;
    font: "JetBrains Mono Bold 12";
}

entry {
    background-color: transparent;
    text-color: #ffffffff;
    placeholder: "Type to search applications…";
    placeholder-color: @muted-color;
}

mode-switcher {
    spacing: 2px;
    background-color: transparent;
    expand: false;
}

button {
    padding: 9px 10px;
    background-color: transparent;
    text-color: #929badff;
    border: 0px 0px 2px 0px;
    border-color: transparent;
    border-radius: 0px;
}

button selected {
    background-color: transparent;
    text-color: #ffffffff;
    border-color: #f43f5eff;
}

message {
    padding: 0px;
    background-color: transparent;
    expand: false;
}

message textbox {
    padding: 8px 10px;
    background-color: #11151cff;
    text-color: @muted-color;
    border-radius: 7px;
}

listview {
    columns: 1;
    lines: 7;
    fixed-height: true;
    fixed-columns: true;
    dynamic: false;
    expand: true;
    spacing: 0px;
    scrollbar: true;
    layout: vertical;
    background-color: transparent;
}

element {
    orientation: horizontal;
    padding: 10px 12px;
    spacing: 13px;
    background-color: transparent;
    text-color: #dce2ebff;
    border: 0px 0px 1px 0px;
    border-color: #202632ff;
    border-radius: 0px;
}

element alternate.normal {
    background-color: transparent;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @accent-soft;
    text-color: #ffffffff;
    border-color: @accent-soft;
    border-radius: 8px;
}

element-icon {
    size: 32px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    horizontal-align: 0.0;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

scrollbar {
    width: 5px;
    handle-color: #566074ff;
    background-color: #151922ff;
    border-radius: 5px;
}

textbox {
    background-color: transparent;
}

textbox-help {
    str: "Ctrl+Left/Right  tabs   •   Arrows  select   •   Enter  open   •   Esc  close";
    padding: 6px 4px 0px;
    background-color: transparent;
    text-color: #707a8dff;
    font: "JetBrains Mono 9";
    expand: false;
}
