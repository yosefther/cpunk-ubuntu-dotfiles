configuration {
    show-icons: true;
    icon-theme: "Yaru";
    modi: "drun";
    matching: "fuzzy";
    case-sensitive: false;
    sidebar-mode: true;
    drun-use-desktop-cache: false;
    click-to-exit: true;
    font: "Cantarell 12";
    kb-move-word-back: "Alt+b";
    kb-move-word-forward: "Alt+f";
    kb-mode-next: "Control+Right,Control+Tab";
    kb-mode-previous: "Control+Left,Control+ISO_Left_Tab";
}
* {
    background-color: #0b0d12ed;
    text-color: #eef2f7ff;
    border-color: #3a4252ff;
    selected-color: #9f1239f2;
    selected-border: #f43f5eff;
    muted-color: #929badff;
}

window {
    width: 700px;
    height: 540px;
    location: center;
    anchor: center;
    transparency: "real";
    background-color: #0b0d12ed;
    border: 1px;
    border-color: #3a4252e6;
    border-radius: 20px;
}

mainbox {
    children: [ inputbar, mode-switcher, message, listview, textbox-help ];
    spacing: 10px;
    padding: 14px;
    background-color: transparent;
    expand: true;
}

inputbar {
    children: [ textbox-search, entry ];
    padding: 15px 17px;
    spacing: 12px;
    background-color: #181c25e8;
    border: 1px;
    border-color: #3a4252e6;
    border-radius: 12px;
    expand: false;
}

textbox-search {
    str: "⌕";
    background-color: transparent;
    text-color: #f43f5eff;
    font: "Cantarell Bold 18";
}

entry {
    background-color: transparent;
    text-color: #ffffffff;
    placeholder: "Search apps, files, and commands";
    placeholder-color: @muted-color;
    font: "Cantarell 13";
}

mode-switcher {
    spacing: 5px;
    padding: 0px 3px;
    background-color: transparent;
    expand: false;
}

button {
    padding: 7px 10px;
    background-color: transparent;
    text-color: @muted-color;
    border: 1px;
    border-color: transparent;
    border-radius: 7px;
    font: "Cantarell 11";
}

button selected {
    background-color: #3a1720e8;
    text-color: #ffffffff;
    border-color: #f43f5ecc;
}

message {
    padding: 0px;
    background-color: transparent;
    expand: false;
}

message textbox {
    padding: 8px 10px;
    background-color: #11151cff;
    text-color: @muted-color;
    border-radius: 7px;
}

listview {
    columns: 1;
    lines: 6;
    fixed-height: true;
    fixed-columns: true;
    dynamic: false;
    expand: true;
    spacing: 3px;
    scrollbar: true;
    layout: vertical;
    background-color: transparent;
}

element {
    orientation: horizontal;
    padding: 10px 13px;
    spacing: 14px;
    background-color: transparent;
    text-color: #eef2f7ff;
    border: 1px;
    border-color: transparent;
    border-radius: 9px;
}

element alternate.normal {
    background-color: transparent;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @selected-color;
    text-color: #ffffffff;
    border-color: @selected-border;
    border-radius: 9px;
}

element-icon {
    size: 38px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    horizontal-align: 0.0;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
    font: "Cantarell 13";
}

scrollbar {
    width: 5px;
    handle-color: #566074ff;
    background-color: #151922cc;
    border-radius: 5px;
}

textbox {
    background-color: transparent;
}

textbox-help {
    str: "↑  ↓  Navigate     Enter  Open     Esc  Close     Ctrl+←/→  Tabs";
    padding: 11px 4px 2px;
    background-color: transparent;
    text-color: @muted-color;
    border: 1px 0px 0px 0px;
    border-color: #303746cc;
    font: "Cantarell 10";
    expand: false;
}
